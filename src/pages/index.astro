---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReviewCard from "../components/ReviewCard.astro";
import Stars from "../components/Stars.astro";
import { getCollection } from "astro:content";
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	KEYWORDS,
	APPSUMO_PRODUCT_URL,
	APPSUMO_REVIEWS_URL,
	PRODUCT_URL,
	RATING_AVERAGE,
	RATING_TOTAL,
	REVIEWS_PUBLISHED,
} from "../consts";

import {
	graph,
	productSchema,
	publisherSchema,
	websiteSchema,
	faqSchema,
	type ReviewData,
} from "../lib/schema";

const reviews = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const reviewData: ReviewData[] = reviews.map((r) => ({
	...r.data,
	slug: r.id,
}));

const faqs = [
	{
		q: "Is WebAbility.io any good?",
		a: `WebAbility.io holds ${RATING_AVERAGE} out of 5 across ${RATING_TOTAL} verified reviews on AppSumo — 25 five-star, one four-star, none below. Reviewers most consistently praise the support and the speed of setup. The most repeated criticism is that discovered fixes need to be applied manually and that this is not obvious on first use.`,
	},
	{
		q: "What do reviewers say is wrong with WebAbility.io?",
		a: "Three things recur: fixes the scan finds still need applying and the interface does not make that obvious; there is no bulk issue export and large-site workflows are thin, including template-level issues that repeat across pages; and a May 2025 reviewer reported the widget was not fully translated and the screen reader skipped words.",
	},
	{
		q: "Is the WebAbility.io AppSumo deal worth it?",
		a: "Reviewers who bought it say yes, including one with over 500 AppSumo purchases who ranks it at the top of them. Tiers run $59 to $295 as a one-time payment, refundable up to 60 days. One consultant recovered the $295 top tier on a single client sale.",
	},
	{
		q: "Can agencies use WebAbility.io for client sites?",
		a: "Yes. A top-tier reviewer confirmed white-label, multiple widget placements and a silent background fix mode. Licences cover multiple sites and codes stack up to 5.",
	},
	{
		q: "Who publishes webabilityreviews.com?",
		a: "The WebAbility team (TechyWeb Solutions Inc.). The reviews themselves were written by verified AppSumo purchasers, not by us, and every one links back to its original so it can be checked.",
	},
];

const structuredData = graph(
	publisherSchema(),
	websiteSchema(),
	productSchema(reviewData),
	faqSchema(faqs),
);

const themes = [
	{
		title: "Support is the most-cited reason people stay",
		body: "Across the set, the founder replying directly comes up more often than any single feature. One reviewer went to the top tier on the strength of the walkthrough alone.",
	},
	{
		title: "Setup is short — finishing the job is the part people ask about",
		body: "Installs land in about ten minutes. The recurring stumble is not installation but applying the fixes the scan has already found.",
	},
	{
		title: "The open request is scale",
		body: "Bulk exports, large-site workflows, and template-level issues that repeat across many pages. That is the sharpest ask in the reviews.",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			keywords={KEYWORDS.home}
			structuredData={structuredData}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Verified customer reviews</p>
				<h1>WebAbility.io reviews — what verified buyers actually say</h1>
				<p class="lede">
					WebAbility.io is an AI-powered web accessibility platform for ADA,
					WCAG&nbsp;2.1/2.2, AODA and Section&nbsp;508 compliance. Below are
					verified customer reviews, reproduced from its AppSumo listing with a
					link back to each original.
				</p>

				<div class="rating-panel">
					<div class="score">
						<span class="number">{RATING_AVERAGE}</span>
						<Stars rating={RATING_AVERAGE} label={`out of 5`} />
						<span class="count">{RATING_TOTAL} verified reviews on AppSumo</span>
					</div>
					<div class="ctas">
						<a class="btn primary" href={APPSUMO_PRODUCT_URL} rel="nofollow noopener" target="_blank">
							See the deal on AppSumo
						</a>
						<a class="btn" href={PRODUCT_URL} rel="noopener" target="_blank">
							Visit WebAbility.io
						</a>
					</div>
				</div>

				<p class="disclosure">
					This site is run by the WebAbility team. Reviews are not written by us
					— they are summarised from the {RATING_TOTAL} published on AppSumo, each
					linked to its source. {REVIEWS_PUBLISHED} of the {RATING_TOTAL} are
					covered here, including the one review that is not five stars.
				</p>
			</section>

			<section class="themes">
				<h2>What comes up repeatedly</h2>
				<div class="theme-grid">
					{
						themes.map((t) => (
							<div class="theme">
								<h3>{t.title}</h3>
								<p>{t.body}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="reviews">
				<h2>The reviews</h2>
				<div class="grid">
					{
						reviews.map((r) => (
							<ReviewCard
								href={`/reviews/${r.id}/`}
								title={r.data.title}
								reviewer={r.data.reviewer}
								rating={r.data.rating}
								pubDate={r.data.pubDate}
								quote={r.data.quote}
								description={r.data.description}
								verified={r.data.verified}
							/>
						))
					}
				</div>
				<p class="more">
					<a href={APPSUMO_REVIEWS_URL} rel="nofollow noopener" target="_blank">
						Read all {RATING_TOTAL} reviews on AppSumo →
					</a>
				</p>
			</section>

			<section class="paths">
				<h2>Reading this for a specific reason?</h2>
				<div class="path-grid">
					<a class="path" href="/for-agencies/">
						<h3>You run an agency →</h3>
						<p>
							White-label, reselling to clients, multiple sites per licence, and
							what agency reviewers say is still missing.
						</p>
					</a>
					<a class="path" href="/manual-accessibility-audit/">
						<h3>You need a manual audit →</h3>
						<p>
							What an expert WCAG audit catches that no automated scan can, and
							how to tell which one your situation needs.
						</p>
					</a>
				</div>
			</section>

			<section class="faq-section">
				<h2>Questions people ask about WebAbility.io</h2>
				<dl class="faq">
					{
						faqs.map((f) => (
							<div class="qa">
								<dt>{f.q}</dt>
								<dd>{f.a}</dd>
							</div>
						))
					}
				</dl>
			</section>
		</main>
		<Footer />

		<style>
			main {
				width: min(1100px, calc(100% - 2em));
				margin: 0 auto;
				padding: 3em 0;
			}
			.eyebrow {
				margin: 0 0 0.5rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--accent);
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: clamp(2rem, 5vw, 3rem);
				line-height: 1.15;
			}
			.lede {
				max-width: 62ch;
				font-size: 1.05rem;
				color: rgb(var(--gray-dark));
			}
			.rating-panel {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				margin: 2rem 0 1rem;
				padding: 1.5rem;
				border-radius: 12px;
				background: var(--gray-gradient);
				border: 1px solid rgb(var(--gray-light));
			}
			.score {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.number {
				font-size: 2.5rem;
				font-weight: 700;
				line-height: 1;
			}
			.count {
				width: 100%;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.ctas {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.btn {
				display: inline-block;
				padding: 0.7rem 1.25rem;
				border-radius: 8px;
				border: 1px solid var(--accent);
				color: var(--accent);
				background: white;
				font-weight: 700;
				text-decoration: none;
			}
			.btn.primary {
				background: var(--accent);
				color: white;
			}
			.btn:hover {
				box-shadow: var(--box-shadow);
			}
			.disclosure {
				max-width: 70ch;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			section + section {
				margin-top: 3.5rem;
			}
			h2 {
				font-size: 1.6rem;
				margin-bottom: 1.25rem;
			}
			.theme-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.5rem;
			}
			.theme h3 {
				margin: 0 0 0.4rem;
				font-size: 1.05rem;
			}
			.theme p {
				margin: 0;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.5rem;
			}
			.more {
				margin-top: 2rem;
				font-weight: 700;
			}
			.path-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
			}
			.path {
				display: block;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				text-decoration: none;
				color: inherit;
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}
			.path:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			.path h3 {
				margin: 0 0 0.4rem;
				font-size: 1.1rem;
				color: var(--accent);
			}
			.path p {
				margin: 0;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
			}
			.faq {
				margin: 0;
				max-width: 75ch;
			}
			.faq .qa + .qa {
				margin-top: 1.25rem;
			}
			.faq dt {
				font-weight: 700;
				color: rgb(var(--black));
			}
			.faq dd {
				margin: 0.35rem 0 0;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 720px) {
				main {
					padding: 2em 0;
				}
			}
		</style>
	</body>
</html>

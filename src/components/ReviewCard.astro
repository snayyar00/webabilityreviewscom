---
import FormattedDate from "./FormattedDate.astro";
import Stars from "./Stars.astro";

interface Props {
	href: string;
	title: string;
	reviewer: string;
	rating: number;
	pubDate: Date;
	quote?: string;
	description: string;
	verified?: boolean;
}

const {
	href,
	title,
	reviewer,
	rating,
	pubDate,
	quote,
	description,
	verified = true,
} = Astro.props;
---

<article class="review-card">
	<div class="meta">
		<Stars rating={rating} />
		<span class="date"><FormattedDate date={pubDate} /></span>
	</div>
	<h3><a href={href}>{title}</a></h3>
	{quote && <p class="quote">{quote}</p>}
	<p class="summary">{description}</p>
	<p class="byline">
		<span class="reviewer">{reviewer}</span>
		{verified && <span class="badge">Verified purchaser</span>}
	</p>
</article>

<style>
	.review-card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		height: 100%;
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: white;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.review-card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.date {
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	h3 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.3;
	}
	h3 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--accent);
	}
	.quote {
		margin: 0;
		font-style: italic;
		color: var(--accent);
		border-left: 3px solid var(--accent);
		padding-left: 0.75rem;
	}
	.summary {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		flex: 1;
	}
	.byline {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.reviewer {
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.badge {
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		font-size: 0.75rem;
	}
</style>
